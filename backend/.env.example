# Copie en `.env` (non versionné). En prod: généré par la CI depuis BACKEND_ENV.

GEMINI_API_KEY=...
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
SECRET_KEY=change-me-long-random-string
MODEL_GEMINI=gemini-2.0-flash
# Modèle du triage rapide sur images (optionnel)
MODEL_GEMINI_CLASSIFICATION=gemini-3.5-flash-lite
# Modèle de repli si le principal renvoie 503 UNAVAILABLE (saturé). Optionnel.
MODEL_GEMINI_FALLBACK=gemini-3.5-flash-lite

# Logging du coût des appels Gemini (tokens + USD + EUR). 0 pour le couper.
GEMINI_COST_LOG=1
# Taux de change USD -> EUR utilisé dans les logs de coût (BCE, 2026-09-01).
USD_EUR_RATE=0.86281

# Origines autorisées pour CORS (séparées par des virgules).
# En prod, mets l'URL publique du front, ex: https://sbd.exemple.com
CORS_ORIGINS=http://localhost:5173

# Limites d'upload vidéo (optionnel, valeurs par défaut ci-dessous)
MAX_UPLOAD_MB=50
MAX_VIDEO_SECONDS=60

# Durée de validité du JWT en jours (optionnel)
JWT_TTL_DAYS=7
